[Definition]
# Vulnerability probes that return 404. See nginx-wp-scan for the log format and
# why <HOST> is anchored after the user agent.
_pre = ^[^"]*"[A-Z]+ [^ "]*
_post = [^ "]*(?: [^"]*)?"
_tail = \d+ "[^"]*" "[^"]*" .*?<HOST> [0-9.]+ .*$

failregex = %(_pre)s(?:\.env|alfacgiapi|ALFA_DATA|/admin|\.git\b|\.aws|phpmyadmin)%(_post)s[ ]404 %(_tail)s

ignoreregex =
