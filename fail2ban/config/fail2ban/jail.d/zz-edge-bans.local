# Adds the Cloudflare edge ban and an AbuseIPDB report to every web jail. The host
# firewall action stays as it was. This file sorts after the per-jail files, so its
# action line wins.
# cfaccount comes from 02-cloudflare-edge.local (gitignored). The Cloudflare token
# and the AbuseIPDB key live in root-only header files that the actions read with
# curl -H @file (see the two action files), never in a jail or on a command line. AbuseIPDB categories: 14 port scan,
# 15 hacking, 19 bad web bot, 21 web app attack.

[nginx-aggressive-scan]
action = iptables-allports[name=nginx-aggressive-scan]
         cloudflare-edge[name=nginx-aggressive-scan, cfaccount="%(cfaccount)s"]
         abuseipdb-nomercy[name=nginx-aggressive-scan, abuseipdb_category="14,21"]

[nginx-bad-bots]
action = iptables-allports[name=nginx-bad-bots]
         cloudflare-edge[name=nginx-bad-bots, cfaccount="%(cfaccount)s"]
         abuseipdb-nomercy[name=nginx-bad-bots, abuseipdb_category="19"]

[nginx-direct-access]
action = iptables-allports[name=nginx-direct-access]
         cloudflare-edge[name=nginx-direct-access, cfaccount="%(cfaccount)s"]
         abuseipdb-nomercy[name=nginx-direct-access, abuseipdb_category="21"]

