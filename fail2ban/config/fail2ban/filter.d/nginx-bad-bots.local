[Definition]
# Known scanner user agents. See nginx-wp-scan for the log format and why <HOST>
# is anchored after the user agent. The user agent is the second quoted field
# after the status, so the pattern cannot match the request path or referer.
_req = ^[^"]*"[^"]*" \d{3} \d+ "[^"]*"
_tail = .*?<HOST> [0-9.]+ .*$

failregex = %(_req)s "[^"]*(?:MJ12bot|masscan|zgrab|sqlmap|Nmap|python-requests|ALFA_DATA|alfacgiapi)[^"]*" %(_tail)s
            ^[^"]*"[^"]*" 404 \d+ "[^"]*" "[^"]*(?:curl|Wget)[^"]*" %(_tail)s

ignoreregex =
