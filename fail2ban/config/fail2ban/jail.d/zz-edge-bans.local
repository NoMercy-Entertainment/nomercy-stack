# Adds the Cloudflare edge ban and an AbuseIPDB report to every web jail. The host
# firewall action stays as it was. This file sorts after the per-jail files, so its
# action line wins.
# cftoken and cfaccount come from 02-cloudflare-edge.local, abuseipdb_apikey from
# 03-abuseipdb.local (both gitignored). AbuseIPDB categories: 14 port scan,
# 15 hacking, 19 bad web bot, 21 web app attack.

[nginx-aggressive-scan]
action = iptables-allports[name=nginx-aggressive-scan]
         cloudflare-edge[name=nginx-aggressive-scan, cftoken="%(cftoken)s", cfaccount="%(cfaccount)s"]
         abuseipdb-nomercy[name=nginx-aggressive-scan, abuseipdb_apikey="%(abuseipdb_apikey)s", abuseipdb_category="14,21"]

[nginx-bad-bots]
action = iptables-allports[name=nginx-bad-bots]
         cloudflare-edge[name=nginx-bad-bots, cftoken="%(cftoken)s", cfaccount="%(cfaccount)s"]
         abuseipdb-nomercy[name=nginx-bad-bots, abuseipdb_apikey="%(abuseipdb_apikey)s", abuseipdb_category="19"]

