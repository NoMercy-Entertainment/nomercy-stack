[nginx-aggressive-scan]
enabled = true
filter = nginx-aggressive-scan
logpath = /remotelogs/nginx/access.log
maxretry = 2   # the least certain probe names: two hits, not one (stack#4)
findtime = 86400
bantime = 604800   # 7 days: a wrong match must end (stack#4)
action = iptables-allports[name=nginx-aggressive-scan]
