[nginx-wp-scan]
enabled = true
port = http,https
filter = nginx-wp-scan
logpath = /remotelogs/nginx/access.log
maxretry = 1
# 7 days: a wrong match must end (stack#4). 24 h window. No inline comments:
# fail2ban keeps them in the value and falls back to its default.
bantime = 604800
findtime = 86400
backend = auto
action = iptables-allports[name=nginx-wp-scan]
