# Copy to .env (gitignored) and fill in. Never commit the real values.
# Address CoreDNS binds to on this host (the LXC host's LAN address).
DNS_BIND_IP=192.0.2.60
# Leave at 53 in production.
DNS_PORT=53
# Same value as the TXT_UPDATER_TOKEN on ns1.
TXT_UPDATER_TOKEN=change-me
# Where the zone is fetched from (the tunnel sidecar forwards this to ns1).
ZONE_URL=http://tunnel:8081/zone
# ns1 host and the restricted account the tunnel key logs in as.
TUNNEL_HOST=ns1.example.com
TUNNEL_USER=tunnel
# Private key and pinned host key, mounted read-only (both gitignored).
TUNNEL_KEY_FILE=./secrets/tunnel_key
TUNNEL_KNOWN_HOSTS=./secrets/known_hosts
