[Definition]
# Directory and backup-file scanning that returns 404. See nginx-wp-scan for the
# log format and why <HOST> is anchored after the user agent.
# The old pattern matched words like "api", "app", "new" and "old" anywhere in
# the request, so one 404 for a normal path could ban a real user for ever. This
# one needs a probe name at the start of a path segment, or an archive or backup
# file extension. Only the path counts: _pre stops at "?", so a search such as
# /search?q=backup.zip never matches. The name or extension must end at "/",
# ".", "?", "_", "-", or the end of the path (a space), checked with a lookahead;
# "$" never matched there, so /backup and /site.zip were missed (stack#4).
_pre = ^[^"]*"[A-Z]+ [^ "?]*
_post = [^ "]*(?: [^"]*)?"
_tail = \d+ "[^"]*" "[^"]*" .*?<HOST> [0-9.]+ .*$

failregex = %(_pre)s(?:/(?:old|backup|backups|bak|wordpress|wp-[a-z]+|phpmyadmin|pma|webmail|ftp|sql|database|dump|config|setup|install)(?=[/.?_ -])|\.(?:zip|tar|tgz|gz|rar|7z|bak|old|sql|swp)(?=[? ]))%(_post)s[ ]404 %(_tail)s

ignoreregex =
